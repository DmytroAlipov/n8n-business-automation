      "id": "7c762b95-00e3-48c1-a2bc-15e426b6abd5",
      "name": "OpenAI Lead Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        -208,
        864
      ],
