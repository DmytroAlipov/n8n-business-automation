    {
      "parameters": {
        "jsCode": "const b = $json.body ?? $json;\nconst clean = (v, n) => String(v ?? '').replace(/[\\u0000-\\u001f\\u007f]+/g, ' ').trim().slice(0, n);\n\nconst email = clean(b.email, 254).toLowerCase();\nconst name = clean(b.name, 200);\nconst company = clean(b.company, 200);\nconst message = String(b.message ?? '').replace(/[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]/g, '').trim().slice(0, 4000);\n\nconst errors = [];\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errors.push('a valid email is required');\nif (!name) errors.push('name is required');\nif (!message) errors.push('message is required');\nif (errors.length) return [{ json: { valid: false, errors } }];\n\nconst toBool = v => v === true || ['true', '1', 'yes', 'y'].includes(String(v).trim().toLowerCase());\nconst empRaw = Number(b.employees ?? 0);\nconst employees = Number.isFinite(empRaw) && empRaw > 0 ? Math.floor(empRaw) : 0;\n\nreturn [{\n  json: {\n    valid: true,\n    lead_id: `LEAD-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,\n    received_at: new Date().toISOString(),\n    name, email, company,\n    phone: clean(b.phone, 50),\n    message,\n    message_fingerprint: message.toLowerCase().replace(/\\s+/g, ' ').slice(0, 300),\n    employees,\n    industry: clean(b.industry || 'unknown', 100),\n    source: clean(b.source || 'website', 100),\n    website: clean(b.website, 300),\n    demo_requested: toBool(b.demo_requested)\n  }\n}];"
      },
