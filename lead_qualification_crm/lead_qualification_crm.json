    {
      "parameters": {
        "jsCode": "const req = $('Normalize Lead').first().json;\nconst cfg = $('Config').first().json;\n\n// find() returns one empty item when nothing matches (alwaysOutputData) - keep real leads only\nconst past = $input.all().map(i => i.json).filter(l => l && l.lead_id);\n\nconst dup = past.find(l => l.message_fingerprint === req.message_fingerprint);\nconst limited = past.length >= Number(cfg.max_submissions_per_window);\n\nreturn [{\n  json: {\n    ...req,\n    skip: Boolean(dup) || limited,\n    skip_status: dup ? 'duplicate' : limited ? 'rate_limited' : 'ok',\n    skip_code: dup ? 200 : limited ? 429 : 200,\n    existing_lead_id: dup ? dup.lead_id : null\n  }\n}];"
      },
