    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"score\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 65\n    },\n    \"intent\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"buy\",\n        \"evaluate\",\n        \"learn\",\n        \"support\",\n        \"unknown\"\n      ]\n    },\n    \"fit\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"strong\",\n        \"moderate\",\n        \"weak\"\n      ]\n    },\n    \"reason\": {\n      \"type\": \"string\"\n    },\n    \"next_action\": {\n      \"type\": \"string\"\n    },\n    \"sales_summary\": {\n      \"type\": \"string\"\n    },\n    \"email_reply\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"score\",\n    \"intent\",\n    \"fit\",\n    \"reason\",\n    \"next_action\",\n    \"sales_summary\",\n    \"email_reply\"\n  ],\n  \"additionalProperties\": false\n}"
      },
      "id": "48f70171-8354-480b-b922-cc5ac6d17e9f",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        -32,
        864
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst src = $('Normalize Lead').first().json;\nconst AI_MAX = 65; // the AI scores message content only; the workflow adds up to 35 more points\n\n// 1) Read the AI output (object from the structured parser, or a string as a fallback)\nconst raw = $json.output;\nlet ai = null;\nif (raw && typeof raw === 'object') {\n  ai = raw;\n} else {\n  const s = String(raw ?? '').trim();\n  const a = s.indexOf('{'), b = s.lastIndexOf('}');\n  try { if (a >= 0 && b > a) ai = JSON.parse(s.slice(a, b + 1)); } catch (e) { ai = null; }\n}\nconst aiFailed = !(ai && Number.isFinite(Number(ai.score)));\n\nconst fallback = {\n  score: 0, intent: 'unknown', fit: 'weak',\n  reason: 'AI output could not be parsed - manual review required',\n  next_action: 'Manual review',\n  sales_summary: '',\n  email_reply: 'Thank you for contacting us. We have received your request and our team will follow up with you shortly.'\n};\nconst base = aiFailed ? fallback : { ...fallback, ...ai };\nconst intents = ['buy', 'evaluate', 'learn', 'support', 'unknown'];\nconst fits = ['strong', 'moderate', 'weak'];\n\n// 2) Score = AI (message only) + deterministic bonuses, with a transparent breakdown\nconst breakdown = [];\nlet score = Math.max(0, Math.min(AI_MAX, Number(base.score) || 0));\nbreakdown.push({ rule: 'ai_message_score', points: score });\nconst bonus = (rule, points, on) => { if (on && Number(points) > 0) { score += Number(points); breakdown.push({ rule, points: Number(points) }); } };\n\nconst domain = (src.email.split('@')[1] || '').toLowerCase();\nconst freeDomains = String(cfg.free_email_domains).split(',').map(s => s.trim().toLowerCase()).filter(Boolean);\nbonus('business_email', cfg.bonus_business_email, !freeDomains.includes(domain));\nbonus('demo_requested', cfg.bonus_demo_requested, src.demo_requested);\nbonus('employees_100', cfg.bonus_employees_100, src.employees >= 100);\nbonus('employees_500', cfg.bonus_employees_500, src.employees >= 500);\nscore = Math.min(score, 100);\n\n// 3) Fail-safe: if the AI failed, never let a real lead fall to COLD silently\nif (aiFailed) {\n  const floor = Number(cfg.warm_threshold);\n  if (score < floor) { breakdown.push({ rule: 'ai_failed_floor', points: floor - score }); score = floor; }\n}\n\nconst temperature = score >= Number(cfg.hot_threshold) ? 'HOT' : score >= Number(cfg.warm_threshold) ? 'WARM' : 'COLD';\n\nconst intent = intents.includes(base.intent) ? base.intent : 'unknown';\nconst fit = fits.includes(base.fit) ? base.fit : 'weak';\nconst reason = String(base.reason ?? '').slice(0, 1000);\nconst next_action = String(base.next_action ?? '').slice(0, 500);\nconst sales_summary = String(base.sales_summary ?? '').slice(0, 1000);\nconst email_reply = String(base.email_reply ?? fallback.email_reply).replace(/https?:\\/\\/\\S+/gi, '').trim().slice(0, 1500);\n\n// 4) Slack text: lead-controlled values must be escaped (prevents <!channel> / link injection)\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst slack_message = [\n  '🔥 *HOT LEAD*',\n  `${esc(src.name)} — ${esc(src.company || 'No company')}`,\n  `Email: ${esc(src.email)}`,\n  `Score: *${score}/100* | Intent: ${esc(intent)} | Fit: ${esc(fit)}`,\n  `Demo requested: ${src.demo_requested ? 'yes' : 'no'} | Employees: ${src.employees || 'n/a'}`,\n  aiFailed ? '⚠️ AI scoring failed - please review manually' : '',\n  '',\n  `Summary: ${esc(sales_summary)}`,\n  `Next action: ${esc(next_action)}`\n].filter((l, i, arr) => l !== '' || (arr[i - 1] !== '' && i !== arr.length - 1)).join('\\n');\n\nreturn [{\n  json: {\n    ...src,\n    score, temperature, intent, fit, reason, next_action, sales_summary, email_reply,\n    score_breakdown: breakdown,\n    ai_failed: aiFailed,\n    slack_message,\n    qualified_at: new Date().toISOString()\n  }\n}];"
      },
