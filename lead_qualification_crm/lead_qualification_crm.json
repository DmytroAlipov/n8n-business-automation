            {
              "id": "e96451de-d6b0-4a3a-834b-ba485e7d1dd8",
              "leftValue": "={{ $json.skip }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
