    {
      "parameters": {
        "jsCode": "const h128 = (str) => {\n  const seeds = [0x811c9dc5, 0x9e3779b1, 0x85ebca6b, 0xc2b2ae35];\n  let o = '';\n  for (const s0 of seeds) {\n    let h = s0 >>> 0;\n    for (let i = 0; i < str.length; i++) {\n      h ^= str.charCodeAt(i);\n      h = Math.imul(h, 16777619) >>> 0;\n      h = (h ^ (h >>> 15)) >>> 0;\n    }\n    o += ('00000000' + h.toString(16)).slice(-8);\n  }\n  return o;\n};\nconst toUuid = (h) => h.slice(0, 8) + '-' + h.slice(8, 12) + '-4' + h.slice(13, 16) + '-8' + h.slice(17, 20) + '-' + h.slice(20, 32);\n\nconst cfg = $('Config').first().json.cfg;\nconst units = (text, size) => {\n  const out = [];\n  for (const para of text.split(/\\n{2,}/)) {\n    let p = para.trim();\n    if (!p) continue;\n    while (p.length > size) {\n      let cut = Math.max(p.lastIndexOf('. ', size), p.lastIndexOf('? ', size), p.lastIndexOf('! ', size));\n      if (cut < size * 0.5) cut = p.lastIndexOf(' ', size);\n      if (cut <= 0) cut = size;\n      out.push(p.slice(0, cut + 1).trim());\n      p = p.slice(cut + 1).trim();\n    }\n    if (p) out.push(p);\n  }\n  return out;\n};\nconst pack = (us, size, overlap) => {\n  const chunks = [];\n  let cur = '';\n  for (const u of us) {\n    if (cur && (cur.length + 2 + u.length) > size) {\n      chunks.push(cur);\n      const tail = cur.slice(-overlap);\n      const sp = tail.indexOf(' ');\n      cur = (sp > -1 ? tail.slice(sp + 1) : tail) + '\\n\\n' + u;\n      if (cur.length > size) cur = u;\n    } else {\n      cur = cur ? cur + '\\n\\n' + u : u;\n    }\n  }\n  if (cur) chunks.push(cur);\n  return chunks;\n};\nreturn $input.all().map(it => {\n  const d = it.json;\n  const chunks = pack(units(d.text, cfg.chunk_size), cfg.chunk_size, cfg.chunk_overlap);\n  if (chunks.length === 0) return { json: { ...d, text: '', chunks: [], fail_reason: 'no_chunks' } };\n  if (chunks.length > cfg.max_chunks_per_doc) return { json: { ...d, text: '', chunks: [], fail_reason: 'too_many_chunks (' + chunks.length + ')' } };\n  return { json: { ...d, text: '', chunks: chunks.map((t, i) => ({\n    index: i,\n    text: t,\n    embed_text: d.title + '\\n' + t,\n    point_id: toUuid(h128(d.doc_id + '|' + d.content_hash + '|' + i)),\n  })) } };\n});"
      },
