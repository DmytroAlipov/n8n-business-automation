    {
      "parameters": {
        "jsCode": "const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst rid = $('Tag Ingest').first().json.request_id;\nconst rows = $input.all().map(i => i.json);\nconst by = (s) => rows.filter(r => r.status === s);\nconst summary = {\n  indexed: by('indexed').length,\n  indexed_with_cleanup_warning: by('indexed_with_cleanup_warning').length,\n  skipped: by('skipped').length,\n  rejected: by('rejected').length,\n  failed: by('failed').length,\n};\nlet http = 200;\nif (summary.failed > 0 || summary.indexed_with_cleanup_warning > 0) http = (summary.indexed + summary.indexed_with_cleanup_warning + summary.skipped > 0) ? 207 : 502;\nelse if (summary.rejected > 0 && summary.indexed === 0 && summary.skipped === 0) http = 422;\nconst failed = [...by('failed'), ...by('indexed_with_cleanup_warning')];\nconst slack_text = failed.length\n  ? ':warning: *KB ingestion*: ' + failed.length + ' document(s) failed or need cleanup (request `' + esc(rid) + '`)' + '\\n' +\n    failed.slice(0, 10).map(f => '• `' + esc(f.doc_id) + '`: ' + esc(String(f.detail || '').slice(0, 160))).join('\\n')\n  : '';\nreturn [{ json: {\n  http_status: http,\n  has_failures: failed.length > 0,\n  slack_text,\n  response: { request_id: rid, summary, results: rows.map(r => ({ doc_id: r.doc_id, status: r.status, detail: r.detail })) },\n} }];"
      },
