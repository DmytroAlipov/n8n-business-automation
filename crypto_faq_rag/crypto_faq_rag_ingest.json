              "value": "{\n  \"qdrant_url\": \"http://qdrant:6333\",\n  \"embedding_model\": \"text-embedding-3-small\",\n  \"embedding_dim\": 1536,\n  \"collections\": [\n    \"faq\",\n    \"fees_limits\",\n    \"compliance\"\n  ],\n  \"languages\": [\n    \"ru\",\n    \"en\",\n    \"es\"\n  ],\n  \"chunk_size\": 900,\n  \"chunk_overlap\": 120,\n  \"max_chunks_per_doc\": 120,\n  \"max_docs_per_request\": 20,\n  \"max_doc_chars\": 60000,\n  \"max_question_chars\": 800,\n  \"top_k\": 4,\n  \"score_threshold\": 0.3,\n  \"min_best_score\": 0.4,\n  \"max_context_chunks\": 6,\n  \"max_chunk_chars\": 1200,\n  \"answer_min_groundedness\": 0.8,\n  \"clarify_min_groundedness\": 0.55,\n  \"min_answer_confidence\": 0.6,\n  \"rate_limit_per_minute\": 8,\n  \"cache_ttl_minutes\": 60,\n  \"alert_cooldown_minutes\": 30,\n  \"slack_channel_id\": \"C0000000000\"\n}",
