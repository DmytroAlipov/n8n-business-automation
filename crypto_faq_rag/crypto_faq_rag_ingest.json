      "parameters": {
        "jsCode": "const docs = $('Validate Ingest').all().map(i => i.json).filter(d => d._valid);\nconst reg = new Map($input.all().map(i => i.json).filter(r => r.doc_id).map(r => [r.doc_id, r]));\nreturn docs.map(d => {\n  const ex = reg.get(d.doc_id);\n  let action = 'new';\n  if (ex) {\n    if (Number(ex.version) > d.version && !d.allow_downgrade) action = 'stale_version';\n    else if (d.force) action = 'forced';\n    else if (ex.content_hash === d.content_hash && ex.status === 'indexed') action = 'unchanged';\n    else action = ex.status === 'indexed' ? 'changed' : 'retry';\n  }\n  return { json: { ...d, action, needs_indexing: !['unchanged', 'stale_version'].includes(action) } };\n});"
