    {
      "parameters": {
        "jsCode": "const h128 = (str) => {\n  const seeds = [0x811c9dc5, 0x9e3779b1, 0x85ebca6b, 0xc2b2ae35];\n  let o = '';\n  for (const s0 of seeds) {\n    let h = s0 >>> 0;\n    for (let i = 0; i < str.length; i++) {\n      h ^= str.charCodeAt(i);\n      h = Math.imul(h, 16777619) >>> 0;\n      h = (h ^ (h >>> 15)) >>> 0;\n    }\n    o += ('00000000' + h.toString(16)).slice(-8);\n  }\n  return o;\n};\nconst toUuid = (h) => h.slice(0, 8) + '-' + h.slice(8, 12) + '-4' + h.slice(13, 16) + '-8' + h.slice(17, 20) + '-' + h.slice(20, 32);\n\nconst cfg = $('Config').first().json.cfg;\nconst entry = $input.first().json;\nconst payload = entry.payload || {};\nconst reqId = entry.request_id;\nconst fail = (msg) => [{ json: { request_id: reqId, request_error: msg } }];\n\nif (typeof payload !== 'object' || !Array.isArray(payload.documents) || payload.documents.length === 0)\n  return fail('documents must be a non-empty array');\nif (payload.documents.length > cfg.max_docs_per_request)\n  return fail('too many documents (max ' + cfg.max_docs_per_request + ')');\n\nconst clean = (s) => String(s ?? '')\n  .replace(/[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]/g, '')\n  .replace(/[ \\t]+/g, ' ')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\n\nconst out = [];\nconst seen = new Set();\nfor (const d of payload.documents) {\n  const errs = [];\n  const doc_id = String(d && d.doc_id != null ? d.doc_id : '').trim();\n  if (!/^[A-Za-z0-9._-]{3,80}$/.test(doc_id)) errs.push('doc_id must match [A-Za-z0-9._-]{3,80}');\n  if (seen.has(doc_id)) errs.push('duplicate doc_id in request');\n  seen.add(doc_id);\n  const collection = String(d && d.collection != null ? d.collection : '');\n  if (!cfg.collections.includes(collection)) errs.push('unknown collection');\n  const lang = String(d && d.lang != null ? d.lang : 'en').toLowerCase();\n  if (!cfg.languages.includes(lang)) errs.push('unsupported lang');\n  const title = clean(d && d.title).slice(0, 200);\n  if (!title) errs.push('title is required');\n  const text = clean(d && d.text);\n  if (!text) errs.push('text is required');\n  if (text.length > cfg.max_doc_chars) errs.push('text is too long (max ' + cfg.max_doc_chars + ' chars)');\n  const version = d && Number.isInteger(d.version) && d.version > 0 ? d.version : 1;\n  const category = clean(d && d.category).slice(0, 50) || 'general';\n  const ok = errs.length === 0;\n  out.push({ json: {\n    request_id: reqId,\n    doc_id: doc_id.slice(0, 80), title, collection, lang, category, version,\n    text: ok ? text : '',\n    force: payload.force === true,\n    allow_downgrade: payload.allow_downgrade === true,\n    _valid: ok,\n    errors: errs,\n    content_hash: ok ? h128(JSON.stringify({ collection, title, lang, category, text })) : '',\n  } });\n}\nreturn out;"
      },
