        "jsCode": "const cfg = $('Config').first().json.cfg;\nconst docs = $('Chunk Documents').all().map(x => x.json).filter(d => !d.fail_reason);\nreturn $input.all().map((it, i) => {\n  const d = docs[i];\n  const r = it.json;\n  const { chunks, ...rest } = d;\n  const vecs = (Array.isArray(r.data) ? r.data.slice().sort((a, b) => a.index - b.index) : []).map(x => x.embedding);\n  const bad = r.error || vecs.length !== chunks.length || vecs.some(v => !Array.isArray(v) || v.length !== cfg.embedding_dim);\n  if (bad) {\n    const msg = r.error ? (r.error.message || JSON.stringify(r.error)) : 'invalid embeddings response';\n    return { json: { ...rest, fail_reason: 'embedding_failed: ' + String(msg).slice(0, 200) } };\n  }\n  const now = new Date().toISOString();\n  const points = chunks.map((c, k) => ({\n    id: c.point_id,\n    vector: vecs[k],\n    payload: {\n      doc_id: d.doc_id, title: d.title, collection: d.collection, lang: d.lang, category: d.category,\n      version: d.version, content_hash: d.content_hash, chunk_index: c.index, text: c.text, indexed_at: now,\n    },\n  }));\n  return { json: { ...rest, points, chunks_count: points.length } };\n});"
      },
