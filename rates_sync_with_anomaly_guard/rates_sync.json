    {
      "parameters": {
        "jsCode": "const plan = $('Build Requests').first().json;\n\n// The HTTP node splits an array response into one item per element\nconst rows = $input.all().map(i => i.json).filter(r => r && r.symbol);\nconst bySymbol = Object.fromEntries(rows.map(r => [r.symbol, Number(r.price)]));\n\nconst prices = {};\nconst missing = [];\nfor (const a of plan.assets) {\n  const v = bySymbol[a.symbol + plan.vs.toUpperCase()];\n  if (Number.isFinite(v) && v > 0) prices[a.symbol] = v; else missing.push(a.symbol);\n}\n\nreturn [{\n  json: {\n    source: 'binance',\n    ok: missing.length === 0,\n    prices,\n    fetched_at: new Date().toISOString(),\n    reason: missing.length ? `invalid or missing prices: ${missing.join(', ')}` : null\n  }\n}];"
      },
