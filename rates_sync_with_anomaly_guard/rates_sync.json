    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\n\nlet assets;\ntry { assets = JSON.parse(cfg.assets); } catch (e) { throw new Error('Config.assets must be valid JSON'); }\nif (!Array.isArray(assets) || !assets.length) throw new Error('Config.assets must be a non-empty array');\nfor (const a of assets) {\n  if (!/^[a-z0-9-]+$/.test(a.id ?? '') || !/^[A-Z0-9]+$/.test(a.symbol ?? '')) {\n    throw new Error(`Invalid asset definition: ${JSON.stringify(a)}`);\n  }\n}\n\nconst vs = String(cfg.vs_currency).trim().toLowerCase();\nif (!/^[a-z]{3,5}$/.test(vs)) throw new Error('Config.vs_currency is invalid');\n\nconst ids = assets.map(a => a.id).join(',');\nconst pairs = assets.map(a => a.symbol + vs.toUpperCase());\n\nreturn [{\n  json: {\n    assets, vs,\n    coingecko_url: `https://api.coingecko.com/api/v3/simple/price?ids=${ids}&vs_currencies=${vs}`,\n    binance_url: `https://api.binance.com/api/v3/ticker/price?symbols=${encodeURIComponent(JSON.stringify(pairs))}`\n  }\n}];"
      },
