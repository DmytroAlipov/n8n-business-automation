    },
    {
      "parameters": {
        "jsCode": "const plan = $('Build Requests').first().json;\nconst res = $json;\n\nconst prices = {};\nconst missing = [];\nfor (const a of plan.assets) {\n  const v = Number(res?.[a.id]?.[plan.vs]);\n  if (Number.isFinite(v) && v > 0) prices[a.symbol] = v; else missing.push(a.symbol);\n}\n\nreturn [{\n  json: {\n    source: 'coingecko',\n    ok: missing.length === 0,\n    prices,\n    fetched_at: new Date().toISOString(),\n    reason: missing.length ? `invalid or missing prices: ${missing.join(', ')}` : null\n  }\n}];"
      },
