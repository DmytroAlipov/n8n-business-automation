      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst safe = fn => { try { return fn(); } catch (e) { return null; } };\n\nconst m = $('Load Monitor State').all().map(i => i.json).find(x => x && x.job === 'rates_sync') ?? {};\nconst failures = (Number(m.consecutive_failures) || 0) + 1;\nconst now = new Date().toISOString();\n\nconst primary = safe(() => $('Mark Primary Failed').first().json.reason)\n  ?? safe(() => $('Normalize CoinGecko').first().json.reason) ?? 'unknown';\nconst fallback = safe(() => $('Mark Fallback Failed').first().json.reason)\n  ?? safe(() => $('Normalize Binance').first().json.reason) ?? 'unknown';\n\n// Alert once the threshold is reached, then at most once per cooldown while the outage lasts\nconst sinceAlertMin = m.last_alert_at ? (Date.now() - new Date(m.last_alert_at).getTime()) / 60000 : Infinity;\nconst shouldAlert = failures >= Number(cfg.failure_alert_after) && sinceAlertMin >= Number(cfg.alert_cooldown_min);\n\nconst lastGood = $('Load Previous Rates').all().map(i => i.json.updated_at).filter(Boolean).sort().pop();\nconst staleMin = lastGood ? Math.round((Date.now() - new Date(lastGood).getTime()) / 60000) : null;\n\nconst message =\n  `🔴 Rates sync failing (${failures} runs in a row)\\n` +\n  `Primary (CoinGecko): ${primary}\\n` +\n  `Fallback (Binance): ${fallback}\\n` +\n  `Last good update: ${staleMin === null ? 'never' : staleMin + ' min ago'}\\n` +\n  `Prices in the database are stale until a source recovers.`;\n\nreturn [{\n  json: {\n    job: 'rates_sync', status: 'down',\n    consecutive_failures: failures,\n    last_failure_at: now,\n    last_error: `primary: ${primary} | fallback: ${fallback}`.slice(0, 500),\n    last_alert_at: shouldAlert ? now : (m.last_alert_at ?? null),\n    should_alert: shouldAlert,\n    message\n  }\n}];"
      },
