    {
      "parameters": {
        "jsCode": "const e = $json.error;\nconst msg = typeof e === 'string' ? e : (e?.message ?? JSON.stringify(e ?? {}).slice(0, 200));\nreturn [{ json: { reason: `request failed: ${msg}` } }];"
      },
      "id": "37e96bcb-208b-4335-8cfd-4510c6f39749",
      "name": "Mark Fallback Failed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1664,
        1024
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst plan = $('Build Requests').first().json;\nconst cur = $input.first().json;               // { source, prices, fetched_at }\nconst maxPct = Number(cfg.max_change_pct);\nconst confirmN = Number(cfg.confirm_readings);\n\nconst prev = {};\nfor (const i of $('Load Previous Rates').all()) {\n  const r = i.json;\n  if (r && r.asset) prev[r.asset] = r;\n}\n\nconst round = n => Math.round(n * 100) / 100;\nconst out = [];\n\nfor (const a of plan.assets) {\n  const price = cur.prices[a.symbol];\n  const p = prev[a.symbol];\n  const base = {\n    asset: a.symbol, currency: plan.vs.toUpperCase(), price,\n    source: cur.source, fetched_at: cur.fetched_at, last_checked_at: cur.fetched_at,\n    confirm_readings: confirmN\n  };\n\n  // First time we see this asset\n  if (!p || !(Number(p.price) > 0)) {\n    out.push({ json: { ...base, status: 'first', prev_price: null, change_pct: 0, anomaly_streak: 0, last_suspect_price: null, updated_at: cur.fetched_at, alert: false } });\n    continue;\n  }\n\n  const prevPrice = Number(p.price);\n  const change = round((price - prevPrice) / prevPrice * 100);\n\n  // Normal move -> accept\n  if (Math.abs(change) <= maxPct) {\n    out.push({ json: { ...base, status: 'ok', prev_price: prevPrice, change_pct: change, anomaly_streak: 0, last_suspect_price: null, updated_at: cur.fetched_at, alert: false } });\n    continue;\n  }\n\n  // Big jump. Count it only if consecutive suspicious readings agree with each other\n  let streak = Number(p.anomaly_streak) || 0;\n  const lastSuspect = Number(p.last_suspect_price);\n  if (streak > 0 && lastSuspect > 0 && Math.abs((price - lastSuspect) / lastSuspect * 100) > maxPct) streak = 0;\n\n  if (streak + 1 >= confirmN) {\n    // The market really moved: accept the new price and tell people\n    out.push({ json: { ...base, status: 'confirmed_move', prev_price: prevPrice, change_pct: change, anomaly_streak: 0, last_suspect_price: null, updated_at: cur.fetched_at, alert: true } });\n  } else {\n    // Keep the last good price, remember the suspicious one, alert only on the first sighting\n    out.push({ json: { ...base, status: 'suspect', prev_price: prevPrice, change_pct: change, anomaly_streak: streak + 1, last_suspect_price: price, alert: streak === 0 } });\n  }\n}\n\nreturn out;"
      },
