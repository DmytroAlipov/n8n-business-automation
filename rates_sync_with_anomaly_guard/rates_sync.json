    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst fmt = n => Number(n).toLocaleString('en-US', { maximumFractionDigits: 2 });\nconst sign = n => (n > 0 ? '+' : '') + n;\n\nconst lines = rows.map(r => r.status === 'confirmed_move'\n  ? `✅ ${r.asset}: move confirmed after ${r.confirm_readings} consistent readings\\n   ${fmt(r.prev_price)} → ${fmt(r.price)} ${r.currency} (${sign(r.change_pct)}%) - price UPDATED`\n  : `⚠️ ${r.asset}: suspicious jump, price NOT updated\\n   ${fmt(r.prev_price)} → ${fmt(r.price)} ${r.currency} (${sign(r.change_pct)}%)`);\n\nreturn [{ json: { text: `📈 Rates monitor (source: ${rows[0].source})\\n\\n${lines.join('\\n\\n')}` } }];"
      },
      "id": "8ab00b30-2223-46bc-93c9-abbdf804dfe4",
      "name": "Build Alert Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2608,
        544
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst m = $('Load Monitor State').all().map(i => i.json).find(x => x && x.job === 'rates_sync') ?? {};\nconst failures = Number(m.consecutive_failures) || 0;\n\n// \"was down\" = an alert was actually sent (failures reached the alert threshold)\nconst wasDown = failures >= Number(cfg.failure_alert_after);\nconst source = $('Evaluate Rates').first().json.source;\n\nreturn [{\n  json: {\n    job: 'rates_sync',\n    status: 'ok',\n    consecutive_failures: 0,\n    last_success_at: new Date().toISOString(),\n    last_alert_at: null,\n    was_down: wasDown,\n    recovery_message: `✅ Rates sync recovered after ${failures} failed run(s). Active source: ${source}.`\n  }\n}];"
      },
