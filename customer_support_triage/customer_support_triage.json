      "id": "7c3ec1e3-52b1-4edb-9f32-138c9c8b456b",
      "name": "Find Customer History",
      "type": "n8n-nodes-base.mongoDb",
      "typeVersion": 1.2,
      "position": [
        1568,
        1056
      ],
      "alwaysOutputData": true,
      "credentials": {
        "mongoDb": {
          "id": "xhsfsqq25iZMV5LD",
          "name": "MongoDB account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const req = $('Normalize & Validate').first().json;\nconst cfg = $('Config').first().json;\n\n// find() returns one empty item when nothing matches (alwaysOutputData) - keep real tickets only\nconst past = $input.all().map(i => i.json).filter(t => t && t.request_id);\n\nconst now = Date.now();\nconst dup = past.find(t =>\n  t.message_fingerprint === req.message_fingerprint &&\n  now - new Date(t.received_at).getTime() < Number(cfg.duplicate_window_min) * 60000\n);\n\nconst escapeRe = s => s.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\nconst text = req.message.toLowerCase();\nconst keywordHits = String(cfg.escalation_keywords).split(',')\n  .map(s => s.trim().toLowerCase()).filter(Boolean)\n  .filter(k => new RegExp(`(^|[^\\\\p{L}])${escapeRe(k)}([^\\\\p{L}]|$)`, 'u').test(text));\n\nreturn [{\n  json: {\n    ...req,\n    previous_tickets: past.length,\n    recent_categories: [...new Set(past.map(t => t.category).filter(Boolean))].slice(0, 5),\n    is_duplicate: Boolean(dup),\n    duplicate_of: dup ? dup.request_id : null,\n    keyword_hits: keywordHits\n  }\n}];"
      },
      "id": "b144b1ee-b2f9-485d-b2fd-7b92a4dd4455",
      "name": "Summarize History",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        1056
      ]
    },
