    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst customer = body.customer ?? {};\nconst errors = [];\n\nconst message = String(body.message ?? body.text ?? '').trim().slice(0, 4000);\nconst email = String(customer.email ?? '').trim().toLowerCase();\nconst phone = String(customer.phone ?? '').replace(/\\D/g, '');\nconst channels = ['webhook', 'email', 'whatsapp', 'web', 'chat'];\nconst ch = String(body.channel ?? '').trim().toLowerCase();\nconst channel = channels.includes(ch) ? ch : 'webhook';\n\nif (!message) errors.push('message is required');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errors.push('customer.email is missing or invalid');\nif (channel === 'whatsapp' && phone.length < 8) errors.push('customer.phone is required for the whatsapp channel');\n\nif (errors.length) return [{ json: { valid: false, errors } }];\n\nreturn [{\n  json: {\n    valid: true,\n    request_id: `SUP-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,\n    received_at: new Date().toISOString(),\n    customer_id: String(customer.id ?? email).slice(0, 100),\n    customer_name: String(customer.name ?? '').trim().slice(0, 100) || 'Customer',\n    customer_email: email,\n    customer_phone: phone,\n    order_id: String(body.order_id ?? '').trim().slice(0, 100),\n    message,\n    message_fingerprint: message.toLowerCase().replace(/\\s+/g, ' ').slice(0, 300),\n    channel\n  }\n}];"
      },
