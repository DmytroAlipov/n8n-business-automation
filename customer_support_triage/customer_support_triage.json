          "sort": "{\"received_at\": -1}"
        },
        "query": "={{ JSON.stringify({ customer_email: $json.customer_email, received_at: { $gte: new Date(Date.now() - $('Config').first().json.repeat_window_days * 86400000).toISOString() } }) }}"
