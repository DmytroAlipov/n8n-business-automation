        "jsCode": "const items = $input.all().map(i => i.json);\nconst lines = items.slice(0, 15).map(t => `• ${t.request_id} | ${t.priority}/${t.category} | due ${t.sla_due_at} | ${t.customer_name}`);\nconst more = items.length > 15 ? `\\n…and ${items.length - 15} more` : '';\nreturn [{ json: { count: items.length, text: `⏰ SLA breached: ${items.length} ticket(s)\\n${lines.join('\\n')}${more}` } }];"
