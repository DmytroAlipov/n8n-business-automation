        },
        "builtInTools": {},
        "options": {}
      },
      "id": "b8ba937d-f2c3-4332-9272-3e0fb81d18fa",
      "name": "OpenAI Support Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        2160,
        1312
      ],
      "credentials": {
        "openAiApi": {
          "id": "QCJajJ5SkjwYO9MC",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"order\",\n        \"delivery\",\n        \"refund\",\n        \"payment\",\n        \"technical\",\n        \"account\",\n        \"warranty\",\n        \"other\"\n      ]\n    },\n    \"priority\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"low\",\n        \"medium\",\n        \"high\",\n        \"urgent\"\n      ]\n    },\n    \"sentiment\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"positive\",\n        \"neutral\",\n        \"negative\",\n        \"angry\"\n      ]\n    },\n    \"intent\": {\n      \"type\": \"string\"\n    },\n    \"summary\": {\n      \"type\": \"string\"\n    },\n    \"requires_human\": {\n      \"type\": \"boolean\"\n    },\n    \"language\": {\n      \"type\": \"string\"\n    },\n    \"customer_reply\": {\n      \"type\": \"string\"\n    },\n    \"internal_action\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"category\",\n    \"priority\",\n    \"sentiment\",\n    \"intent\",\n    \"summary\",\n    \"requires_human\",\n    \"language\",\n    \"customer_reply\",\n    \"internal_action\"\n  ],\n  \"additionalProperties\": false\n}"
      },
      "id": "7594d6ae-2dee-42fa-bf10-882e7eed6bb0",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        2336,
        1312
      ]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Summarize History').first().json;\nconst cfg = $('Config').first().json;\n\n// 1) Read the AI output (object from the structured parser, or a string as a fallback)\nconst raw = $json.output;\nlet ai = null;\nif (raw && typeof raw === 'object') {\n  ai = raw;\n} else {\n  const s = String(raw ?? '').trim();\n  const a = s.indexOf('{'), b = s.lastIndexOf('}');\n  try { if (a >= 0 && b > a) ai = JSON.parse(s.slice(a, b + 1)); } catch (e) { ai = null; }\n}\n\nconst enums = {\n  category: ['order','delivery','refund','payment','technical','account','warranty','other'],\n  priority: ['low','medium','high','urgent'],\n  sentiment: ['positive','neutral','negative','angry']\n};\nconst valid = ai\n  && Object.entries(enums).every(([k, v]) => v.includes(ai[k]))\n  && typeof ai.requires_human === 'boolean';\n\n// 2) FAIL-SAFE: if the AI failed we escalate to a human, never auto-reply\nconst base = valid ? ai : {\n  category: 'other', priority: 'high', sentiment: 'neutral', intent: 'unknown',\n  summary: 'AI triage failed - manual review required.', requires_human: true,\n  language: 'en', customer_reply: '', internal_action: 'Review the request manually.'\n};\n\n// 3) Deterministic business rules on top of the AI decision\nconst order = ['low', 'medium', 'high', 'urgent'];\nconst atLeast = (p, min) => order.indexOf(p) >= order.indexOf(min) ? p : min;\nconst bump = p => order[Math.min(order.indexOf(p) + 1, order.length - 1)];\n\nlet priority = base.priority;\nlet requires_human = base.requires_human;\nconst reasons = [];\n\nif (!valid) reasons.push('ai_triage_failed');\nif (valid && base.requires_human) reasons.push('ai_requires_human');\nif (ctx.keyword_hits.length) {\n  requires_human = true; priority = atLeast(priority, 'high');\n  reasons.push('keywords:' + ctx.keyword_hits.join('|'));\n}\nif (ctx.previous_tickets >= Number(cfg.repeat_contact_threshold)) {\n  requires_human = true; priority = bump(priority);\n  reasons.push('repeat_contact:' + ctx.previous_tickets);\n}\nif (base.sentiment === 'angry') {\n  requires_human = true; priority = atLeast(priority, 'high');\n  reasons.push('angry_customer');\n}\n\n// 4) Sanitize the customer-facing text (no links, capped length)\nconst customer_reply = String(base.customer_reply ?? '').replace(/https?:\\/\\/\\S+/gi, '').trim().slice(0, 900);\nif (!requires_human && !customer_reply) { requires_human = true; reasons.push('empty_ai_reply'); }\n\n// 5) SLA deadline\nconst slaMin = { urgent: cfg.sla_urgent_min, high: cfg.sla_high_min, medium: cfg.sla_medium_min, low: cfg.sla_low_min }[priority];\nconst sla_due_at = new Date(Date.now() + Number(slaMin) * 60000).toISOString();\n\nreturn [{\n  json: {\n    ...ctx,\n    category: base.category,\n    priority,\n    sentiment: base.sentiment,\n    intent: String(base.intent ?? '').slice(0, 300),\n    summary: String(base.summary ?? '').slice(0, 500),\n    language: String(base.language ?? 'en').toLowerCase().slice(0, 5),\n    requires_human,\n    customer_reply,\n    internal_action: String(base.internal_action ?? '').slice(0, 500),\n    escalation_reasons: reasons,\n    sla_due_at,\n    sla_alerted: false,\n    status: requires_human ? 'needs_human' : 'auto_resolved',\n    processed_at: new Date().toISOString()\n  }\n}];"
      },
