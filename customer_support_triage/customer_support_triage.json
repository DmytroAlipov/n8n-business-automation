    {
      "parameters": {
        "jsCode": "const t = $json;\nconst ack = {\n  en: `Hello ${t.customer_name}, we have received your request (ref. ${t.request_id}). A specialist will review it and get back to you.`,\n  es: `Hola ${t.customer_name}, hemos recibido su solicitud (ref. ${t.request_id}). Un especialista la revisará y se pondrá en contacto con usted.`,\n  ru: `Здравствуйте, ${t.customer_name}! Мы получили ваше обращение (№ ${t.request_id}). Специалист рассмотрит его и свяжется с вами.`\n};\nconst lang = ack[t.language] ? t.language : 'en';\n\n// Escalated tickets get a fixed, safe acknowledgement. AI text is only sent for routine questions.\nconst customer_message = t.requires_human\n  ? ack[lang]\n  : `${t.customer_reply}\\n\\nRef: ${t.request_id}`;\n\nreturn [{\n  json: {\n    ...t,\n    customer_message,\n    deliver_via: (t.channel === 'whatsapp' && t.customer_phone) ? 'whatsapp' : 'email'\n  }\n}];"
      },
