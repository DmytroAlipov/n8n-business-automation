    {
      "parameters": {
        "jsCode": "const t = $('Evaluate Table').first().json;\nconst r = $input.first().json;\nif (r && r.error) {\n  return [{ json: { run_id: t.run_id, table_name: t.table_name, status: 'error', candidates: t.candidates, deleted: 0, dry_run: 0,\n    message: 'delete failed: ' + String(r.error.message || r.error).slice(0, 250), cutoff_iso: t.cutoff_iso } }];\n}\nreturn [{ json: { run_id: t.run_id, table_name: t.table_name, status: 'deleted', candidates: t.candidates, deleted: t.candidates, dry_run: 0,\n  message: 'deleted ' + t.candidates + ' rows older than ' + t.retention_days + ' days', cutoff_iso: t.cutoff_iso } }];"
      },
