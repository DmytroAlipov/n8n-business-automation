    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json.cfg;\nconst run = $('Evaluate Lock').first().json;\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst rows = $input.all().map(i => i.json).filter(r => r.table_name);\nconst deleted = rows.reduce((a, r) => a + (Number(r.deleted) || 0), 0);\nconst problems = rows.filter(r => ['error', 'blocked'].includes(r.status));\nconst head = (problems.length ? ':warning:' : ':broom:') + ' *Retention cleanup* `' + esc(run.run_id) + '`' + (cfg.dry_run ? ' (DRY RUN)' : '') +\n  ' - deleted ' + deleted + ' rows, problems: ' + problems.length;\nconst lines = rows.map(r => '• `' + esc(r.table_name) + '`: ' + esc(r.status) + ', candidates ' + (Number(r.candidates) || 0) + ', deleted ' + (Number(r.deleted) || 0) +\n  (r.message ? ' (' + esc(String(r.message).slice(0, 140)) + ')' : ''));\nreturn [{ json: {\n  deleted, problems: problems.length, notify: problems.length > 0 || cfg.notify_always === true,\n  summary: 'tables=' + rows.length + ' deleted=' + deleted + ' problems=' + problems.length,\n  slack_text: head + '\\n' + lines.join('\\n'),\n} }];"
      },
