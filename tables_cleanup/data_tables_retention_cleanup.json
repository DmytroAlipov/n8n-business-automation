    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json.cfg;\nconst run = $('Evaluate Lock').first().json;\nconst now = Date.now();\nreturn cfg.tables.map(t => {\n  const days = Number(t.retention_days != null ? t.retention_days : cfg.retention_days_default);\n  let invalid = '';\n  if (!t.name || !t.table_id || /^REPLACE/.test(String(t.table_id))) invalid = 'table_id is not configured';\n  else if (!t.ts_column) invalid = 'ts_column is required';\n  else if (!Number.isFinite(days) || days < 1) invalid = 'retention_days must be >= 1';\n  const cutoff = now - (Number.isFinite(days) ? days : 0) * 86400000;\n  return { json: {\n    run_id: run.run_id, table_name: t.name, table_id: t.table_id, ts_column: t.ts_column,\n    retention_days: days, cutoff_ms: cutoff, cutoff_iso: new Date(cutoff).toISOString(),\n    invalid, dry_run: cfg.dry_run === true, max_delete: cfg.max_delete_per_table,\n  } };\n});"
      },
      "id": "7f8d5808-e267-495c-a6fc-a85906df202a",
      "name": "Build Plan",
