    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json.cfg;\nconst row = $input.all().map(i => i.json).find(r => r.table_name === '__run__');\nconst started = Number(row && row.ts) || 0;\nconst running = !!row && row.status === 'running' && (Date.now() - started) < cfg.lock_timeout_minutes * 60000;\nreturn [{ json: { can_run: !running, run_id: 'run-' + Date.now(), previous_status: row ? row.status : 'none' } }];"
      },
