        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "={{ $json.ts_column }}",
              "condition": "lt",
              "keyValue": "={{ $json.cutoff_ms }}"
            },
            {
              "keyName": "={{ $json.ts_column }}",
              "condition": "gt",
              "keyValue": 0
            }
          ]
        },
        "limit": "={{ $json.max_delete + 1 }}"
      },
      "id": "a0931153-8d26-44ea-b0b9-3292df22a070",
      "name": "Count Candidates",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        2064,
        320
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const t = $('Loop Tables').first().json;\nconst r = $input.all().map(i => i.json);\nconst err = r.find(x => x.error);\nconst n = r.filter(x => x.id !== undefined && !x.error).length;\nlet status, action, message;\nif (err) { status = 'error'; action = 'NONE'; message = String(err.error && err.error.message ? err.error.message : err.error).slice(0, 300); }\nelse if (n === 0) { status = 'ok'; action = 'NONE'; message = 'nothing to delete'; }\nelse if (n > t.max_delete) { status = 'blocked'; action = 'NONE'; message = 'candidates exceed the safety cap (' + t.max_delete + '); raise max_delete_per_table or clean manually'; }\nelse if (t.dry_run) { status = 'dry_run'; action = 'NONE'; message = 'would delete ' + n + ' rows'; }\nelse { status = 'pending_delete'; action = 'DELETE'; message = n + ' rows to delete'; }\nreturn [{ json: { ...t, candidates: n, status, action, message } }];"
      },
      "id": "90e878a3-ad78-46c8-af23-49d1e9d8f7d4",
      "name": "Evaluate Table",
